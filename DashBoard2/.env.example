# NodeX Dashboard 2 Environment Variables
# Copy this file to .env and insert your project keys from Supabase Dashboard -> Project Settings -> API.
# Dashboard 2 is strictly read-only and requires only the anonymous (anon) public key.
# NEVER insert or expose the service_role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
